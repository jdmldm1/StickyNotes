<Window x:Class="StickyNotes__.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="820" Width="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        MouseDown="Window_MouseDown">
    
    <Border Background="#1e1e1e" BorderBrush="#0084ff" BorderThickness="1.5" CornerRadius="12">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="#ffffff"/>
                <TextBlock Text="Import Microsoft Sticky Notes" FontSize="13" FontWeight="SemiBold" Foreground="#0084ff" Margin="0,10,0,0"/>
                <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="0,5,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5,0,5">
            <Grid Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,5,0,15">
                    <TextBlock Text="Import your existing notes from the Windows Sticky Notes app. This will parse and migrate all active notes from your local database." 
                               Foreground="#88ffffff" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button x:Name="ImportStickyNotesButton" Content="Import Windows Sticky Notes" Click="ImportStickyNotesButton_Click"
                            Height="32" Background="#0084ff" Foreground="#ffffff" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Padding="15,0" Margin="0,0,0,10">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock Text="Have the AI sort all your notes into categories and tags in one pass. Useful occasionally, not something you'll run often."
                               Foreground="#88ffffff" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
                    <Button x:Name="AutoOrganizeSettingsButton" Content="🪄 Auto Organize Notes (AI)" Click="AutoOrganizeSettingsButton_Click"
                            Height="32" Background="#2b2b2b" Foreground="#ffffff" BorderBrush="#444444" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Left" Padding="15,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock Text="Scan for screenshot notes that never got OCR text (e.g. from before OCR worked, or a scan that failed) and fill them in."
                               Foreground="#88ffffff" FontSize="11" TextWrapping="Wrap" Margin="0,15,0,10"/>
                    <Button x:Name="OcrBackfillButton" Content="🔍 Scan Screenshots for Missing OCR Text" Click="OcrBackfillButton_Click"
                            Height="32" Background="#2b2b2b" Foreground="#ffffff" BorderBrush="#444444" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Left" Padding="15,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock x:Name="OcrBackfillStatusTextBlock" Text="" Foreground="#88ffffff" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <TextBlock Text="Secure Notes (right-click any note → Make Secure Note) are encrypted with a vault password you set the first time. If unlocked, lock it now before stepping away - it also locks automatically when you restart the app."
                               Foreground="#88ffffff" FontSize="11" TextWrapping="Wrap" Margin="0,15,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LockVaultButton" Content="🔒 Lock Vault Now" Click="LockVaultButton_Click"
                                Height="32" Background="#2b2b2b" Foreground="#ffffff" BorderBrush="#444444" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Left" Padding="15,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="ChangeVaultPasswordButton" Content="🔑 Change Password" Click="ChangeVaultPasswordButton_Click"
                                Height="32" Background="#2b2b2b" Foreground="#ffffff" BorderBrush="#444444" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Left" Padding="15,0" Margin="10,0,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ChangeVaultPasswordStatusTextBlock" Text="" Foreground="#88ffffff" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,5">
                    <TextBlock Text="Local Ollama AI Configuration" FontSize="13" FontWeight="SemiBold" Foreground="#0084ff"/>
                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="0,5,0,10"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ollama URL:" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,8"/>
                <TextBox x:Name="OllamaUrlTextBox" Grid.Row="2" Grid.Column="1" Background="#2d2d2d" Foreground="#ffffff" BorderBrush="#444444" BorderThickness="1" Padding="5,3" Margin="0,5" CaretBrush="White"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ollama Model:" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,8"/>
                <TextBox x:Name="OllamaModelTextBox" Grid.Row="3" Grid.Column="1" Background="#2d2d2d" Foreground="#ffffff" BorderBrush="#444444" BorderThickness="1" Padding="5,3" Margin="0,5" CaretBrush="White" ToolTip="Leave empty to auto-detect first running model."/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Auto-Tagging:" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,8"/>
                <CheckBox x:Name="AutoTagCheckBox" Grid.Row="4" Grid.Column="1" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,5">
                    <TextBlock Text="Enable AI Auto-Tagging on Screen Capture and Clipboard Import" TextWrapping="Wrap" MaxWidth="220"/>
                </CheckBox>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Docker Setup:" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,8"/>
                <Button x:Name="DockerSetupBtn" Grid.Row="5" Grid.Column="1" Content="Auto Setup via Docker" Click="DockerSetupBtn_Click"
                        ToolTip="Installs and runs Ollama with the Qwen 2.5 Coder:3b model in a local Docker container"
                        Height="28" Background="#2b2b2b" Foreground="#ffffff" BorderBrush="#444444" BorderThickness="1" Margin="0,5" HorizontalAlignment="Left" Padding="15,0"/>

                <TextBlock x:Name="SetupStatusTextBlock" Grid.Row="6" Grid.Column="1" Text="" Foreground="#88ffffff" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,5"/>

                <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,15,0,5">
                    <TextBlock Text="UI Customization" FontSize="13" FontWeight="SemiBold" Foreground="#0084ff"/>
                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="0,5,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Sidebar Opacity:" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,8"/>
                <Grid Grid.Row="8" Grid.Column="1" Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="20" Maximum="100" Value="90"
                            IsSnapToTickEnabled="True" TickFrequency="5"
                            ValueChanged="OpacitySlider_ValueChanged"
                            VerticalAlignment="Center"
                            Foreground="#0084ff"/>
                    <TextBlock x:Name="OpacityLabel" Grid.Column="1" Text="90%" Foreground="#e0e0e0"
                               VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                </Grid>

                <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,15,0,5">
                    <TextBlock Text="JeffsNotes Sync" FontSize="13" FontWeight="SemiBold" Foreground="#0084ff"/>
                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="0,5,0,10"/>
                    <TextBlock Text="Two-way sync with your JeffsNotes web instance. If a note changed on both sides since the last sync, JeffsNotes wins (your local edit is kept in that note's version history)."
                               Foreground="#88ffffff" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <CheckBox x:Name="JeffsNotesSyncEnabledCheckBox" Content="Enable JeffsNotes sync" Foreground="#e0e0e0" Margin="0,0,0,10"/>
                </StackPanel>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Server URL:" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,8"/>
                <TextBox x:Name="JeffsNotesUrlTextBox" Grid.Row="10" Grid.Column="1" Background="#2d2d2d" Foreground="#ffffff" BorderBrush="#444444" BorderThickness="1" Padding="5,3" Margin="0,5" CaretBrush="White" ToolTip="e.g. http://shiloh:8080"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="Auto-sync every:" Foreground="#e0e0e0" VerticalAlignment="Center" Margin="0,8"/>
                <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                    <TextBox x:Name="JeffsNotesIntervalTextBox" Width="60" Background="#2d2d2d" Foreground="#ffffff" BorderBrush="#444444" BorderThickness="1" Padding="5,3" CaretBrush="White"/>
                    <TextBlock Text="minutes" Foreground="#88ffffff" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,5">
                    <Button x:Name="JeffsNotesSyncNowButton" Content="Sync Now" Click="JeffsNotesSyncNowButton_Click"
                            Height="30" Background="#2b2b2b" Foreground="#ffffff" BorderBrush="#444444" BorderThickness="1" Cursor="Hand" Padding="15,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="JeffsNotesSyncStatusTextBlock" Grid.Row="13" Grid.ColumnSpan="2" Text="" Foreground="#88ffffff" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,5"/>
                <TextBlock x:Name="JeffsNotesLastSyncedTextBlock" Grid.Row="14" Grid.ColumnSpan="2" Text="" Foreground="#666666" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5"/>

                <StackPanel Grid.Row="15" Grid.ColumnSpan="2" Margin="0,15,0,5">
                    <TextBlock Text="Backup &amp; Restore" FontSize="13" FontWeight="SemiBold" Foreground="#0084ff"/>
                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="0,5,0,10"/>
                    <TextBlock Text="Back up all your notes, images, and attachments to a single file, or restore from a previous backup. Restoring overwrites your current notes."
                               Foreground="#88ffffff" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                </StackPanel>

                <StackPanel Grid.Row="16" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,5">
                    <Button x:Name="BackupNowButton" Content="Back Up Now" Click="BackupNowButton_Click"
                            Height="30" Background="#0084ff" Foreground="#ffffff" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Padding="15,0" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="RestoreBackupButton" Content="Restore from Backup..." Click="RestoreBackupButton_Click"
                            Height="30" Background="#2b2b2b" Foreground="#ffffff" BorderBrush="#444444" BorderThickness="1" Cursor="Hand" Padding="15,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="BackupStatusTextBlock" Grid.Row="17" Grid.ColumnSpan="2" Text="" Foreground="#88ffffff" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,5"/>

                <StackPanel Grid.Row="18" Grid.ColumnSpan="2" Margin="0,15,0,5">
                    <TextBlock Text="Data Location" FontSize="13" FontWeight="SemiBold" Foreground="#0084ff"/>
                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="0,5,0,10"/>
                    <TextBlock Text="Where your notes database, images, and attachments are stored. Moving it copies everything to the new location and removes it from the old one."
                               Foreground="#88ffffff" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                </StackPanel>

                <StackPanel Grid.Row="19" Grid.ColumnSpan="2" Margin="0,0,0,5">
                    <TextBlock x:Name="DataLocationPathText" Text="" Foreground="#cccccc" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button x:Name="ChangeDataLocationButton" Content="Change Location..." Click="ChangeDataLocationButton_Click"
                            Height="30" Background="#2b2b2b" Foreground="#ffffff" BorderBrush="#444444" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Left" Padding="15,0"/>
                </StackPanel>

                <TextBlock x:Name="DataLocationStatusTextBlock" Grid.Row="20" Grid.ColumnSpan="2" Text="" Foreground="#88ffffff" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,5"/>

                <StackPanel Grid.Row="21" Grid.ColumnSpan="2" Margin="0,15,0,5">
                    <TextBlock Text="Danger Zone" FontSize="13" FontWeight="SemiBold" Foreground="#ff5252"/>
                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="0,5,0,10"/>
                    <TextBlock Text="Permanently deletes every note, image, and attachment. This cannot be undone -- back up first if you're not sure."
                               Foreground="#88ffffff" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                </StackPanel>

                <Button x:Name="ClearAllNotesButton" Grid.Row="22" Grid.ColumnSpan="2" Content="Clear All Notes" Click="ClearAllNotesButton_Click"
                        Height="30" Background="#3a1414" Foreground="#ff8080" BorderBrush="#5c2020" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Left" Padding="15,0" Margin="0,0,0,5"/>
            </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Save" Width="80" Height="28" Background="#0084ff" Foreground="#ffffff" FontWeight="Bold" Click="SaveButton_Click" BorderThickness="0" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Cancel" Width="80" Height="28" Background="#3a3a3a" Foreground="#ffffff" Click="CancelButton_Click" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
