<Window x:Class="StickyNotes__.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StickyNotes__"
        Title="StickyNotes++" Height="800" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <DataTemplate x:Key="NoteCardTemplate">
            <Border x:Name="CardBorder" CornerRadius="8" BorderThickness="1" Cursor="Hand"
                    Background="{Binding CardBackground}"
                    PreviewMouseLeftButtonDown="NoteCard_PreviewMouseLeftButtonDown"
                    MouseMove="NoteCard_MouseMove"
                    ContextMenuOpening="CardBorder_ContextMenuOpening"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="Black" Opacity="0.15"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{Binding CardHeaderBrush}"/>
                        <Setter Property="Margin" Value="0,0,0,14"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CardSize}" Value="Small">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CardSize}" Value="Large">
                                <Setter Property="Margin" Value="0,0,0,18"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1.025" Duration="0:0:0.15" DecelerationRatio="0.8"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1.025" Duration="0:0:0.15" DecelerationRatio="0.8"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Effect.(DropShadowEffect.BlurRadius)"
                                                             To="10" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Effect.(DropShadowEffect.Opacity)"
                                                             To="0.3" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.15" AccelerationRatio="0.8"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.15" AccelerationRatio="0.8"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Effect.(DropShadowEffect.BlurRadius)"
                                                             To="4" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Effect.(DropShadowEffect.Opacity)"
                                                             To="0.15" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="BorderBrush" Value="#0084ff"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CardSize}" Value="Small">
                                    <Setter Property="Margin" Value="10,8,10,8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CardSize}" Value="Large">
                                    <Setter Property="Margin" Value="14"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Title & Hover -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Snippet -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: Task Progress Bar -->
                        <RowDefinition Height="Auto"/> <!-- Row 3: Image -->
                        <RowDefinition Height="Auto"/> <!-- Row 4: Tags -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Note Title -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayTitle}"
                               Foreground="{Binding CardTextBrush}" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CardSize}" Value="Small">
                                        <Setter Property="FontSize" Value="12"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CardSize}" Value="Large">
                                        <Setter Property="FontSize" Value="14.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Favorite/Pin toggle — always visible so favorited notes are easy to spot at a glance -->
                    <Button Grid.Row="0" Grid.Column="1" Click="FavoriteButton_Click" Tag="{Binding Id}" ToolTip="{Binding FavoriteToolTip}"
                            Background="Transparent" BorderThickness="0" Foreground="{Binding FavoriteBrush}"
                            Width="22" Height="22" FontSize="14" Cursor="Hand" Margin="0,0,4,0" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="11"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="{Binding FavoriteIcon}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Quick Open (URL / Attachment) — always visible when applicable -->
                    <Button Grid.Row="0" Grid.Column="2" Click="QuickOpenButton_Click" ToolTip="{Binding QuickOpenToolTip}"
                            Visibility="{Binding QuickOpenVisibility}"
                            Background="#26FFFFFF" BorderThickness="0" Foreground="#ffffff"
                            Width="22" Height="22" FontSize="11" Cursor="Hand" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="11"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="{Binding QuickOpenIcon}" FontSize="12" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Hover Action Icons Panel -->
                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <!-- Color palette menu trigger -->
                        <Button Content="🎨" Click="ColorPaletteFromCard_Click" Tag="{Binding Id}" ToolTip="Change Color"
                                Background="Transparent" BorderThickness="0" Foreground="#e0e0e0" 
                                Width="20" Height="20" FontSize="10" Cursor="Hand" Margin="0,0,3,0" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

                        <!-- Move to Category -->
                        <Button Content="📁" Click="CategoryFromCard_Click" Tag="{Binding Id}" ToolTip="Move to Category"
                                Background="Transparent" BorderThickness="0" Foreground="#e0e0e0" 
                                Width="20" Height="20" FontSize="10" Cursor="Hand" Margin="0,0,3,0" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

                        <!-- Delete note -->
                        <Button Content="✕" Click="DeleteCardButton_Click" Tag="{Binding Id}" ToolTip="Delete Note"
                                Background="Transparent" BorderThickness="0" Foreground="#ff5252" 
                                Width="20" Height="20" FontSize="10" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                    </StackPanel>

                    <!-- Text Snippet (single line, since the title already shows the note's first line) -->
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Snippet}"
                               Foreground="{Binding CardTextBrush}" Margin="0,4,0,0"
                               Visibility="{Binding SnippetVisibility}"
                               TextTrimming="CharacterEllipsis" Opacity="0.8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CardSize}" Value="Large">
                                        <Setter Property="FontSize" Value="12.5"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="MaxHeight" Value="34"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Grid.Row="2" Grid.ColumnSpan="4" Margin="0,8,0,0" Visibility="{Binding TaskProgressVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding TaskStatsText}" Foreground="{Binding CardTextBrush}" FontSize="10.5" Opacity="0.75" Margin="0,0,0,4"/>
                        <ProgressBar Grid.Row="1" Height="4" Value="{Binding TaskProgressPercentage, Mode=OneWay}" Maximum="100" BorderThickness="0" Background="#33FFFFFF" Foreground="#0084ff"/>
                    </Grid>

                    <Border Grid.Row="3" Grid.ColumnSpan="4" MaxHeight="60" CornerRadius="4" ClipToBounds="True" 
                            Margin="0,8,0,0" HorizontalAlignment="Left" Visibility="{Binding ImageVisibility}">
                        <Image Source="{Binding ThumbnailSource}" Stretch="Uniform"/>
                    </Border>

                    <Grid Grid.Row="4" Grid.ColumnSpan="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center" Visibility="{Binding TagsRowVisibility}">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{Binding DataContext.CardHeaderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                BorderThickness="1" Background="#16ffffff" CornerRadius="8" Padding="6,2,4,2" Margin="0,0,4,4"
                                                ContextMenuOpening="TagBorder_ContextMenuOpening">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontSize="9" Foreground="#ffffff" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <Run Text="#"/><Run Text="{Binding Mode=OneWay}"/>
                                                </TextBlock>
                                                <Button Click="RemoveTagButton_Click" Tag="{Binding Mode=OneWay}"
                                                        Background="Transparent" BorderThickness="0" Foreground="#ddffffff" 
                                                        Width="12" Height="12" FontSize="8" Cursor="Hand" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="×" Margin="0,-2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="+" Click="QuickAddTagButton_Click" Tag="{Binding Id}" ToolTip="Quick add tag"
                                    Width="18" Height="18" Padding="0" FontSize="10" Margin="0,0,4,4"
                                    Background="#22ffffff" Foreground="#bbbbbb" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="9"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </WrapPanel>

                        <TextBlock Grid.Column="1" Text="{Binding DateText}" Foreground="{Binding CardTextBrush}"
                                   FontSize="9" Opacity="0.55" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Group header row (category / favorites / notes) used by the virtualized notes list below.
             A plain data row (not an Expander) so it can sit inline in a single flat, virtualizing ListBox
             alongside note cards - collapsing a group simply omits its card rows from the bound list. -->
        <DataTemplate x:Key="NoteGroupHeaderTemplate">
            <Border Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10"
                    Padding="10,9" Margin="0,4,0,10" Cursor="Hand"
                    MouseLeftButtonUp="GroupHeader_Click"
                    ContextMenu="{Binding HeaderContextMenu}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="{Binding ChevronGlyph}" Foreground="#99FFFFFF" FontSize="9"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="12.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <Border Grid.Column="3" Background="{Binding PillBackground}" CornerRadius="8" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Count}" Foreground="{Binding AccentBrush}" FontSize="10.5" FontWeight="Bold"/>
                    </Border>

                    <Button Grid.Column="4" Content="➕" ToolTip="{Binding AddTooltip}" Visibility="{Binding AddButtonVisibility}"
                            Click="GroupHeaderAdd_Click"
                            Background="Transparent" BorderThickness="0" Foreground="{Binding AccentBrush}" FontSize="10"
                            Cursor="Hand" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Picks the group-header row template vs. the note-card template for the flat, virtualized notes list -->
        <local:NotesRowTemplateSelector x:Key="NotesRowTemplateSelector"/>

        <!-- Thin, theme-matching vertical scrollbar for the notes list (replaces the default OS scrollbar) -->
        <Style x:Key="ThinVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#30ffffff" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bare-bones container so ListBoxItem contributes no selection/hover chrome of its own -->
        <Style x:Key="NotesListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainWindowBorder" Background="#E6121212" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12">
        <!-- Root Grid: content + status toast overlay -->
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Logo &amp; Action Icons -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Add Section (Note Manager / New Note / Quick Actions) -->
                <RowDefinition Height="Auto"/> <!-- Row 2: Filter Section (Search / Tags) -->
                <RowDefinition Height="Auto"/> <!-- Row 3: Sort Section (Sort by / Card size) -->
                <RowDefinition Height="Auto"/> <!-- Row 4: Stale Notes Digest Banner -->
                <RowDefinition Height="*"/>    <!-- Row 5: Notes List / Clipboard ScrollViewer -->
            </Grid.RowDefinitions>

            <!-- Section boundary style shared by the Add/Filter/Sort groups below -->
            <Grid.Resources>
                <Style x:Key="SidebarSectionBoundary" TargetType="Border">
                    <Setter Property="Background" Value="#0Cffffff"/>
                    <Setter Property="BorderBrush" Value="#16ffffff"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="10"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                </Style>
                <Style x:Key="SidebarSectionLabel" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#5Cffffff"/>
                    <Setter Property="FontSize" Value="9.5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Margin" Value="2,0,0,8"/>
                </Style>
                <!-- Thin, theme-matching horizontal scrollbar for the tags filter row (replaces the default OS scrollbar) -->
                <Style x:Key="ThinHorizontalScrollBar" TargetType="ScrollBar">
                    <Setter Property="Height" Value="4"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid SnapsToDevicePixels="true">
                                    <Track x:Name="PART_Track" IsEnabled="{TemplateBinding IsEnabled}">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#33ffffff" CornerRadius="2"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

                <!-- Title &amp; Settings Header (Row 0) -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo &amp; Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="app_icon.png" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="StickyNotes++" Foreground="#ffffff" FontSize="16.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Action Button Controls Stack -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Sync Button -->
                        <Button x:Name="SyncIconButton" Content="🔄" Click="SyncIconButton_Click" ToolTip="Sync with JeffsNotes"
                                Width="26" Height="26" Margin="0,0,4,0" Background="Transparent" BorderThickness="0" 
                                Foreground="#ffffff" FontSize="12" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

                        <!-- Options Button -->
                        <Button Content="⚙" Click="SettingsButton_Click" ToolTip="Options"
                                Width="26" Height="26" Margin="0,0,4,0" Background="Transparent" BorderThickness="0" 
                                Foreground="#ffffff" FontSize="13" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

                        <!-- Minimize Sidebar -->
                        <Button Content="—" Click="MinimizeButton_Click" ToolTip="Minimize to Tray"
                                Width="26" Height="26" Margin="0,0,4,0" Background="Transparent" BorderThickness="0" 
                                Foreground="#ffffff" FontSize="11" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

                        <!-- Close Sidebar -->
                        <Button Content="✕" Click="CloseButton_Click" ToolTip="Exit"
                                Width="26" Height="26" Background="Transparent" BorderThickness="0" Margin="0,0,4,0"
                                Foreground="#ffffff" FontSize="11" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                    </StackPanel>
                </Grid>

                <!-- ================= ADD Section (Row 1): Note Manager / New Note / Quick Actions ================= -->
                <Border Grid.Row="1" Style="{StaticResource SidebarSectionBoundary}">
                <StackPanel>
                    <TextBlock Text="ADD" Style="{StaticResource SidebarSectionLabel}"/>

                    <!-- Note Manager + Combined New Note & Template Dropdown Button -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Note Manager (full-screen tabbed browse/edit view) -->
                        <Button Grid.Column="0" Click="NoteManagerButton_Click" ToolTip="Open Note Manager" Width="38" Height="38" Cursor="Hand" BorderThickness="0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0d4a4a" Offset="0"/>
                                    <GradientStop Color="#127a7a" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="🗂" FontSize="14" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Combined New Note & Template Dropdown Button -->
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- New Note Button (left part) -->
                            <Button Grid.Column="0" Click="NewNoteButton_Click" ToolTip="New Note (Win+Alt+N)" Height="38" Cursor="Hand" BorderThickness="0">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0066cc" Offset="0"/>
                                        <GradientStop Color="#0099ff" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8,0,0,8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="✚" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="New Note" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Separator line -->
                            <Border Grid.Column="0" HorizontalAlignment="Right" Width="1" Height="22" Background="#33ffffff" VerticalAlignment="Center" Panel.ZIndex="1"/>

                            <!-- Template picker dropdown (right part) -->
                            <Button x:Name="TemplateButton" Grid.Column="1" Click="TemplateButton_Click" ToolTip="New note from template" Width="32" Height="38" Cursor="Hand" BorderThickness="0">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0066cc" Offset="0"/>
                                        <GradientStop Color="#0099ff" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0,8,8,0"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="▾" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Quick Actions Row -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Screensnip Button -->
                        <Button Grid.Column="0" Click="ScreenshotButton_Click" ToolTip="Screensnip OCR (Win+Alt+S)" Height="32" Cursor="Hand" BorderThickness="1">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1a1a2e" Offset="0"/>
                                    <GradientStop Color="#2d2d44" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="BorderBrush" Value="#444466"/>
                                </Style>
                            </Button.Style>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="7"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📸" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Snip" FontSize="11" FontWeight="SemiBold" Foreground="#cccccc" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Save Browser Tabs Button -->
                        <Button Grid.Column="2" Click="SaveTabsButton_Click" ToolTip="Save open Chrome/Edge tabs (Win+Alt+T)" Height="32" Cursor="Hand" BorderThickness="0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0d7a5f" Offset="0"/>
                                    <GradientStop Color="#12a37f" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="7"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🔗" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Tabs" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Add File Button -->
                        <Button Grid.Column="4" Click="AddFileButton_Click" ToolTip="Save files/documents to a new note (Win+Alt+F)" Height="32" Cursor="Hand" BorderThickness="0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7a4d0d" Offset="0"/>
                                    <GradientStop Color="#a3720f" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="7"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="File" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Quick Meeting Note Button -->
                        <Button Grid.Column="6" Click="MeetingNoteButton_Click" ToolTip="Quick meeting note (Win+Alt+M)" Height="32" Cursor="Hand" BorderThickness="0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#5b2d8f" Offset="0"/>
                                    <GradientStop Color="#7c3fc4" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="7"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📅" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Meet" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
                </Border>

                <!-- ================= FILTER Section (Row 2): Search / Tags ================= -->
                <Border Grid.Row="2" Style="{StaticResource SidebarSectionBoundary}">
                <StackPanel>
                    <TextBlock Text="FILTER" Style="{StaticResource SidebarSectionLabel}"/>

                    <!-- Search Panel -->
                    <Grid x:Name="SearchPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchTextBox" Grid.Column="0" TextChanged="SearchTextBox_TextChanged" Padding="8,6" Background="#1e1e1e" Foreground="#ffffff" BorderThickness="0" CaretBrush="White">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Grid.Column="0" IsHitTestVisible="False" Text="Search notes..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="#8a8a8a" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Advanced/Spotlight search (tag+category+time filters, snippets). Same feature as Win+Alt+Space. -->
                        <Button Grid.Column="1" x:Name="SpotlightButton" Content="🔎" Click="SpotlightButton_Click" ToolTip="Advanced search (Win+Alt+Space)" Margin="6,0,0,0" Padding="8,2" Background="#20ffffff" Foreground="#ffffff" FontSize="13" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Tags Filter Bar -->
                    <ScrollViewer x:Name="TagsFilterScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinHorizontalScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="TagsFilterPanel" Orientation="Horizontal"/>
                    </ScrollViewer>
                </StackPanel>
                </Border>

                <!-- ================= SORT Section (Row 3): Sort by / Card size ================= -->
                <Border Grid.Row="3" Style="{StaticResource SidebarSectionBoundary}">
                <StackPanel>
                    <TextBlock Text="SORT &amp; VIEW" Style="{StaticResource SidebarSectionLabel}"/>

                    <!-- Sort Options Row -->
                    <Grid x:Name="SortPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Sort by:" Foreground="#88ffffff" FontSize="10.5" VerticalAlignment="Center"/>

                        <!-- Sort by Category Button -->
                        <Button Grid.Column="2" x:Name="SortCategoryButton" Content="Category" Click="SortCategoryButton_Click" Margin="6,0,0,0" Padding="8,2" Background="#20ffffff" Foreground="#88ffffff" FontSize="9.5" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Sort by Date Button -->
                        <Button Grid.Column="3" x:Name="SortDateButton" Content="Date (Newest)" Click="SortDateButton_Click" Margin="4,0,0,0" Padding="8,2" Background="#0084ff" Foreground="#ffffff" FontSize="9.5" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Expand/collapse every category group at once - only relevant in Category sort mode -->
                        <Button Grid.Column="4" x:Name="ExpandCollapseAllButton" Content="Collapse All" Click="ExpandCollapseAllButton_Click"
                                Margin="4,0,0,0" Padding="8,2" Background="#20ffffff" Foreground="#88ffffff" FontSize="9.5" BorderThickness="0" Cursor="Hand"
                                Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Card Size Options Row -->
                    <Grid x:Name="ViewSizePanel" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Card size:" Foreground="#88ffffff" FontSize="10.5" VerticalAlignment="Center"/>

                        <!-- Small cards -->
                        <Button Grid.Column="2" x:Name="SizeSmallButton" Content="S" Click="SizeSmallButton_Click" ToolTip="Compact cards" Margin="6,0,0,0" Padding="10,2" Background="#20ffffff" Foreground="#88ffffff" FontSize="9.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Medium cards (default) -->
                        <Button Grid.Column="3" x:Name="SizeMediumButton" Content="M" Click="SizeMediumButton_Click" ToolTip="Medium cards (default)" Margin="4,0,0,0" Padding="10,2" Background="#0084ff" Foreground="#ffffff" FontSize="9.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Large cards -->
                        <Button Grid.Column="4" x:Name="SizeLargeButton" Content="L" Click="SizeLargeButton_Click" ToolTip="Expanded cards" Margin="4,0,0,0" Padding="10,2" Background="#20ffffff" Foreground="#88ffffff" FontSize="9.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
                </Border>

                <!-- Stale Notes Digest Banner (Row 4) -->
                <Border x:Name="StaleNotesBanner" Grid.Row="4" Margin="0,0,0,12" Padding="10,8" CornerRadius="8"
                        Background="#1affa500" BorderBrush="#ffa500" BorderThickness="1" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="StaleNotesText" Text="⏰ 0 notes have open tasks untouched for a while"
                                   Foreground="#ffcc80" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Cursor="Hand" MouseLeftButtonUp="StaleNotesBanner_Click"/>
                        <Button Grid.Column="1" Content="✕" Click="DismissStaleNotesBanner_Click" ToolTip="Dismiss for this session"
                                Background="Transparent" BorderThickness="0" Foreground="#ffcc80"
                                Width="20" Height="20" FontSize="10" Cursor="Hand" VerticalAlignment="Top" Margin="6,0,0,0"/>
                    </Grid>
                </Border>


                <!-- Notes List (Row 5) - flat, virtualized: only on-screen rows (group headers + note cards)
                     are realized, regardless of how many notes exist. Collapsed groups simply aren't
                     included in the bound ItemsSource, so no separate expand/collapse animation is needed. -->
                <ListBox x:Name="NotesListBox" Grid.Row="5"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ItemContainerStyle="{StaticResource NotesListBoxItemStyle}"
                         ItemTemplateSelector="{StaticResource NotesRowTemplateSelector}">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
                    </ListBox.Resources>
                </ListBox>

<Border x:Name="StatusToast" Visibility="Collapsed"
        Background="#DD0a0a0a" BorderBrush="#0084ff" BorderThickness="1"
        CornerRadius="8" Padding="14,10" Margin="12"
        VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="⏳" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusToastText" Text="Processing..."
                   Foreground="#ffffff" FontSize="12" VerticalAlignment="Center"/>
    </StackPanel>
</Border>
</Grid>
</Border>
</Window>

