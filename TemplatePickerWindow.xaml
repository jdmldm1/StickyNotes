<Window x:Class="StickyNotes__.TemplatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Template" Height="440" Width="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Border Background="#F2141414" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="📋  Choose a Template" Foreground="#ffffff" FontSize="14"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Content="✕" Click="CloseButton_Click" HorizontalAlignment="Right"
                        Width="30" Height="26" Margin="0,0,8,0"
                        Background="Transparent" BorderThickness="0" Foreground="#ffffff"
                        FontSize="11" Cursor="Hand"/>
            </Grid>

            <!-- Template Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="12,8,12,0">
                <WrapPanel x:Name="TemplatesPanel" Orientation="Horizontal"/>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#0Affffff" BorderBrush="#20ffffff" BorderThickness="0,1,0,0">
                <TextBlock Text="Click a template to create a new note from it.  User templates show a ✕ button to delete."
                           Foreground="#66ffffff" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</Window>
