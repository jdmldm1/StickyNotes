<Window x:Class="StickyNotes__.GhostScratchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Scratchpad" Height="480" Width="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Border x:Name="ScratchpadCard" Background="#F0181824" BorderBrush="#0084FF" BorderThickness="1.5" CornerRadius="10" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.65" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title & Actions -->
                <RowDefinition Height="*"/>    <!-- Text Area -->
                <RowDefinition Height="Auto"/> <!-- Footer / Stats -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1AFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0" Padding="10,8" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ " FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Ghost Scratchpad" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SavedIndicatorText" Text=" · Saved" Foreground="#4ADE80" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📋" ToolTip="Copy Scratchpad Text" Click="CopyButton_Click"
                                Background="Transparent" Foreground="#A0A0C0" BorderThickness="0" FontSize="11" Padding="4,2" Cursor="Hand" Margin="0,0,2,0"/>
                        <Button Content="📝" ToolTip="Save as Permanent Sticky Note" Click="ConvertToNote_Click"
                                Background="Transparent" Foreground="#A0A0C0" BorderThickness="0" FontSize="11" Padding="4,2" Cursor="Hand" Margin="0,0,2,0"/>
                        <Button Content="🗑" ToolTip="Clear Scratchpad" Click="ClearButton_Click"
                                Background="Transparent" Foreground="#A0A0C0" BorderThickness="0" FontSize="11" Padding="4,2" Cursor="Hand" Margin="0,0,4,0"/>
                        <Button x:Name="PinButton" Content="📌" ToolTip="Toggle Always On Top" Click="PinButton_Click"
                                Background="Transparent" Foreground="#38BDF8" BorderThickness="0" FontSize="11" Padding="4,2" Cursor="Hand" Margin="0,0,2,0"/>
                        <Button Content="✕" ToolTip="Close Scratchpad" Click="CloseButton_Click"
                                Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" FontSize="11" Padding="5,2" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Scratchpad Editor -->
            <Grid Grid.Row="1" Margin="8">
                <TextBox x:Name="ScratchInput" Background="Transparent" Foreground="#F1F5F9"
                         CaretBrush="#38BDF8" BorderThickness="0" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="13.5"
                         TextChanged="ScratchInput_TextChanged"/>
                <TextBlock x:Name="PlaceholderText" Text="Jot a quick thought, paste a link, or dump text here... Automatically autosaved."
                           Foreground="#64748B" FontSize="12.5" FontStyle="Italic" Margin="3,3,0,0" IsHitTestVisible="False"/>
            </Grid>

            <!-- Footer Stats -->
            <Border Grid.Row="2" Background="#101018" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="WordCountText" Text="0 words · 0 chars" Foreground="#64748B" FontSize="9.5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Press Esc or click away to hide" Foreground="#475569" FontSize="9.5" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
