<Window x:Class="StickyNotes__.TeamsMeetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microsoft Teams Meeting Hub" Height="560" Width="720" MinHeight="450" MinWidth="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Border Background="#F2141418" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="👥" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Microsoft Teams Meeting Hub" Foreground="#ffffff" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="CloseButton_Click" ToolTip="Close"
                        Width="32" Height="26" Margin="0,0,8,0" Background="Transparent"
                        BorderThickness="0" Foreground="#ffffff" FontSize="12" Cursor="Hand"/>
            </Grid>

            <!-- Segmented Mode Tabs -->
            <Border Grid.Row="1" Background="#0Dffffff" BorderBrush="#1Affffff" BorderThickness="0,1,0,1" Padding="12,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TabTranscriptBtn" Content="📥 Import Transcript / Recap" Click="TabTranscript_Click"
                            Padding="12,4" Margin="0,0,8,0" Background="#262630" Foreground="#ffffff" FontWeight="SemiBold"
                            BorderBrush="#444455" BorderThickness="1" FontSize="11" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="TabCloudBtn" Content="☁️ Microsoft 365 Cloud Calendar" Click="TabCloud_Click"
                            Padding="12,4" Background="Transparent" Foreground="#a0a0b0" BorderThickness="0"
                            FontSize="11" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Tab 1: Transcript / Recap Import -->
            <Grid x:Name="TranscriptImportPanel" Grid.Row="2" Margin="16,12,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Meeting Title & Open File Strip -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Meeting Title" Foreground="#888899" FontSize="10.5" Margin="0,0,0,3"/>
                        <TextBox x:Name="MeetingTitleTextBox" Text="Sprint Planning &amp; Review" Background="#202026"
                                 Foreground="#ffffff" BorderBrush="#333340" BorderThickness="1" Padding="8,5"
                                 FontSize="12" CaretBrush="White"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <Button Content="📂 Browse .vtt / .txt File" Click="BrowseFile_Click"
                                Padding="12,6" Background="#282834" Foreground="#e0e0e0" BorderBrush="#3f3f50"
                                BorderThickness="1" FontSize="11" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Transcript / Recap Input Box -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Paste Transcript or Meeting Recap:" Foreground="#888899" FontSize="10.5" Margin="0,0,0,3"/>
                    <TextBox x:Name="TranscriptInputTextBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#1a1a20"
                             Foreground="#e0e0e8" BorderBrush="#2e2e3a" BorderThickness="1" Padding="8"
                             FontFamily="Consolas, Segoe UI" FontSize="11" CaretBrush="White"
                             TextChanged="TranscriptInput_TextChanged"/>
                </Grid>

                <!-- Detected Summary Badges -->
                <Border Grid.Row="2" Background="#14141a" BorderBrush="#262634" BorderThickness="1" CornerRadius="6"
                        Margin="0,8,0,8" Padding="10,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="👥 Detected Attendees:" Foreground="#888899" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <WrapPanel x:Name="AttendeesWrapPanel" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock x:Name="ActionItemsBadgeText" Text="🎯 0 action items detected" Foreground="#7ee787" FontSize="10.5" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TranscriptStatsText" Text="💬 0 lines" Foreground="#71717a" FontSize="10.5"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bottom Actions -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="ImportStatusText" Text="" Foreground="#a1a1aa" FontSize="11" Margin="0,0,0,3"/>
                        <CheckBox x:Name="SaveAsSecureCheck" Content="🔒 Save in Encrypted Vault (CUI / DoD / Sensitive)"
                                  Foreground="#7ee787" FontSize="10.5" Cursor="Hand"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📋 Copy BLUF" Click="CopyBluf_Click" ToolTip="Copy executive/military BLUF briefing format to clipboard"
                                Padding="10,6" Margin="0,0,6,0" Background="#1e293b" Foreground="#38bdf8"
                                BorderBrush="#0284c7" BorderThickness="1" FontSize="11" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                        </Button>
                        <Button Content="🛰️ In-Meeting HUD" Click="LaunchHud_Click" ToolTip="Open sleek semi-transparent floating Meeting HUD"
                                Padding="10,6" Margin="0,0,6,0" Background="#2e1065" Foreground="#e9d5ff"
                                BorderBrush="#7c3aed" BorderThickness="1" FontSize="11" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                        </Button>
                        <Button Content="✨ Auto-Detect" Click="AutoDetect_Click" ToolTip="Parse attendees and action items from text"
                                Padding="10,6" Margin="0,0,6,0" Background="#262630" Foreground="#d0d0dc"
                                BorderBrush="#3e3e4f" BorderThickness="1" FontSize="11" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                        </Button>
                        <Button Content="📝 Create Note" Click="CreateStickyNote_Click" ToolTip="Generate a formatted sticky note with attendees, action items, and notes"
                                Padding="14,6" Background="#0084ff" Foreground="#ffffff" FontWeight="Bold"
                                BorderThickness="0" FontSize="11.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Tab 2: Microsoft 365 Cloud Calendar Sync -->
            <Grid x:Name="CloudSyncPanel" Grid.Row="2" Margin="16,12,16,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Setup Card -->
                <Border Grid.Row="0" Background="#16161e" BorderBrush="#2e2e40" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Microsoft 365 / Microsoft Graph Integration" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Text="Connect with your work or school account to pull upcoming Teams meetings, attendees, and meeting links directly." Foreground="#88889a" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button x:Name="SignInBtn" Content="🔑 Sign in with Microsoft 365" Click="SignInMicrosoft_Click"
                                    Padding="14,6" Margin="0,0,10,0" Background="#0078d4" Foreground="#ffffff" FontWeight="SemiBold"
                                    BorderThickness="0" FontSize="11" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                            <Button Content="⚙️ Azure &amp; Gov Cloud Settings" Click="ToggleAzureConfig_Click"
                                    Padding="10,6" Background="#262630" Foreground="#cccccc" BorderBrush="#3f3f50"
                                    BorderThickness="1" FontSize="10.5" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Azure Config Inputs (Optional) -->
                <Border x:Name="AzureConfigBorder" Grid.Row="1" Background="#1a1a24" BorderBrush="#333346" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Microsoft Cloud Environment:" Foreground="#a0a0b0" FontSize="10" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CloudEnvironmentCombo" SelectedIndex="0" Background="#22222e" Foreground="#ffffff" BorderBrush="#3f3f52" Margin="0,0,0,6" SelectionChanged="CloudEnvironmentCombo_SelectionChanged">
                            <ComboBoxItem Content="Commercial / Worldwide (login.microsoftonline.com)" Tag="Commercial"/>
                            <ComboBoxItem Content="US Government DoD (dod.teams.microsoft.us / .mil - login.microsoftonline.us)" Tag="USGovDoD"/>
                            <ComboBoxItem Content="US Government GCC High (login.microsoftonline.us)" Tag="USGovGCCHigh"/>
                        </ComboBox>
                        <TextBlock Text="Custom Azure AD Client ID (Optional for Commercial, Required for DoD/Gov):" Foreground="#a0a0b0" FontSize="10" Margin="0,0,0,3"/>
                        <TextBox x:Name="ClientIdTextBox" Background="#22222e" Foreground="#ffffff" BorderBrush="#3f3f52" BorderThickness="1" Padding="6,3" FontSize="10.5" CaretBrush="White" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TenantLabelTextBlock" Text="Tenant ID (e.g. 'common' or corporate tenant GUID):" Foreground="#a0a0b0" FontSize="10" Margin="0,0,0,3"/>
                        <TextBox x:Name="TenantIdTextBox" Text="common" Background="#22222e" Foreground="#ffffff" BorderBrush="#3f3f52" BorderThickness="1" Padding="6,3" FontSize="10.5" CaretBrush="White"/>

                        <!-- Smartcard / PKI Status Card -->
                        <Border Background="#141c26" BorderBrush="#1e3a5f" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="💳 Smartcard (CAC / PIV) &amp; PKI Status:" Foreground="#93c5fd" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock x:Name="SmartcardStatusTextBlock" Text="Checking Windows Certificate Store..." Foreground="#cbd5e1" FontSize="10" TextWrapping="Wrap"/>
                                <TextBlock Text="Entra ID Certificate-Based Auth (CBA) prompts for your CAC certificate and PIN in Microsoft Edge during login." Foreground="#64748b" FontSize="9.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Device Code Instructions Banner -->
                <Border x:Name="DeviceCodeBanner" Grid.Row="1" Background="#18283a" BorderBrush="#0084ff" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="DeviceCodeInstructionText" Text="To sign in, open https://microsoft.com/devicelogin and enter code:" Foreground="#e0e0ff" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBox x:Name="DeviceCodeTextBox" IsReadOnly="True" FontWeight="Bold" FontSize="13" Foreground="#38bdf8" Background="#101824" BorderBrush="#2563eb" BorderThickness="1" Padding="8,4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="📋 Copy Code &amp; Open Login" Click="OpenDeviceLogin_Click"
                                    Padding="10,4" Background="#0084ff" Foreground="#ffffff" FontWeight="SemiBold"
                                    BorderThickness="0" FontSize="11" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Calendar Meetings List -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📅 Recent &amp; Upcoming Teams Meetings" Foreground="#888899" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#121216">
                        <StackPanel x:Name="CloudMeetingsListPanel" Margin="4"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Status Footer -->
            <Border Grid.Row="3" Background="#0Affffff" BorderBrush="#20ffffff" BorderThickness="0,1,0,0" Padding="12,0">
                <TextBlock Text="🛡️ DoD / IL5 &amp; Commercial: Transcript parsing is 100% offline &amp; local. Zero data ever leaves your device."
                           Foreground="#6ee7b7" FontSize="9.5" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
