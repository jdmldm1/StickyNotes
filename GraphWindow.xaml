<Window x:Class="StickyNotes__.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Mind Graph" Height="700" Width="1000" MinHeight="400" MinWidth="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Border x:Name="WindowBorder" Background="#F2141414" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🕸  Tag Mind Graph" Foreground="#ffffff" FontSize="14"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="—" Click="MinimizeButton_Click" ToolTip="Minimize"
                            Width="30" Height="26" Background="Transparent" BorderThickness="0"
                            Foreground="#ffffff" FontSize="11" Cursor="Hand"/>
                    <Button Content="🗖" Click="MaximizeButton_Click" ToolTip="Maximize"
                            Width="30" Height="26" Background="Transparent" BorderThickness="0"
                            Foreground="#ffffff" FontSize="11" Cursor="Hand"/>
                    <Button Content="✕" Click="CloseButton_Click" ToolTip="Close"
                            Width="30" Height="26" Background="Transparent" BorderThickness="0"
                            Foreground="#ffffff" FontSize="11" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Tag Legend + Controls Strip -->
            <Grid Grid.Row="1" Background="#0Affffff">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="10,6,0,6">
                    <StackPanel x:Name="TagLegendPanel" Orientation="Horizontal"/>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,6,12,6" VerticalAlignment="Center">
                    <CheckBox x:Name="ShowLabelsCheck" Content="Labels" IsChecked="True"
                              Foreground="#aaaaaa" FontSize="11" Margin="0,0,10,0"
                              Checked="ShowLabels_Changed" Unchecked="ShowLabels_Changed"/>
                    <Button Content="↺ Reset" Click="ResetLayout_Click"
                            Padding="8,3" Background="#20ffffff" Foreground="#cccccc"
                            BorderThickness="0" FontSize="11" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Graph Canvas -->
            <Border Grid.Row="2" x:Name="GraphCanvasBorder" Background="#0A0A0A"
                    ClipToBounds="True" Margin="1,0,1,0"
                    MouseWheel="GraphBorder_MouseWheel"
                    MouseLeftButtonDown="GraphBorder_MouseLeftButtonDown"
                    MouseMove="GraphBorder_MouseMove"
                    MouseLeftButtonUp="GraphBorder_MouseLeftButtonUp">
                <Canvas x:Name="GraphCanvas">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="GraphScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="GraphTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                </Canvas>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="#0Affffff" BorderBrush="#20ffffff" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText" Text="" Foreground="#66ffffff" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Border>
        </Grid>
    </Border>
</Window>
