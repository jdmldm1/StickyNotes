<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="StickyNotes++"
           Manufacturer="jdmldm1"
           Version="$(var.ProductVersion)"
           UpgradeCode="46DFB323-947A-473C-9C42-D8FD57254DEE">

    <MajorUpgrade DowngradeErrorMessage="A newer version of StickyNotes++ is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="StickyNotes++" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="StickyNotes++" />
    </StandardDirectory>

    <!-- Harvests every file produced by `dotnet publish` into INSTALLFOLDER -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="4D21AFA7-3655-4F2D-BD38-2251302FFDB2">
      <Shortcut Id="StartMenuShortcut"
                Name="StickyNotes++"
                Description="Sticky notes with screen snips, AI tagging, and more"
                Target="[INSTALLFOLDER]StickyNotes++.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\StickyNotesPlusPlus" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="StickyNotes++" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseFile)" />
  </Package>
</Wix>
