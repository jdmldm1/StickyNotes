<Window x:Class="StickyNotes__.KanbanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual Kanban Board" Height="680" Width="1100" MinHeight="500" MinWidth="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Border Background="#16161E" BorderBrush="#2A2A3C" BorderThickness="1.5" CornerRadius="12" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="6" Opacity="0.7" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Filter / Search bar -->
                <RowDefinition Height="*"/>    <!-- 4 Columns Grid -->
                <RowDefinition Height="Auto"/> <!-- Status footer -->
            </Grid.RowDefinitions>

            <!-- Window Header -->
            <Border Grid.Row="0" Background="#1C1C26" BorderBrush="#28283A" BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0" Padding="14,10" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋 " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Visual Kanban Board" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TotalCardCountText" Text="Loading tasks..." Foreground="#8E8EA0" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🔄" ToolTip="Refresh Board" Click="Refresh_Click"
                                Background="Transparent" Foreground="#A0A0B8" BorderThickness="0" FontSize="12" Padding="6,2" Cursor="Hand" Margin="0,0,4,0"/>
                        <Button Content="🗕" Click="Minimize_Click" Background="Transparent" Foreground="#A0A0B8" BorderThickness="0" FontSize="11" Padding="6,2" Cursor="Hand"/>
                        <Button Content="🗖" Click="Maximize_Click" Background="Transparent" Foreground="#A0A0B8" BorderThickness="0" FontSize="11" Padding="6,2" Cursor="Hand"/>
                        <Button Content="✕" Click="Close_Click" Background="Transparent" Foreground="#A0A0B8" BorderThickness="0" FontSize="11" Padding="8,2" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filter & Search Toolbar -->
            <Border Grid.Row="1" Background="#14141C" BorderBrush="#222230" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox x:Name="SearchBox" Grid.Column="0" Background="#20202C" Foreground="#FFFFFF"
                             BorderBrush="#333346" BorderThickness="1" Padding="8,5" FontSize="11" CaretBrush="White"
                             TextChanged="SearchBox_TextChanged" ToolTip="Filter cards across all columns"/>

                    <!-- Category Filter -->
                    <ComboBox x:Name="CategoryCombo" Grid.Column="1" Margin="10,0,0,0" Width="150"
                              Background="#20202C" Foreground="#FFFFFF" BorderBrush="#333346" FontSize="11"
                              SelectionChanged="CategoryCombo_SelectionChanged"/>
                </Grid>
            </Border>

            <!-- 4 Kanban Columns -->
            <Grid Grid.Row="2" Margin="10,10,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Backlog & Ideas -->
                <Border Grid.Column="0" Background="#14141D" BorderBrush="#262638" BorderThickness="1" CornerRadius="8" Margin="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#1B1B26" CornerRadius="8,8,0,0" Padding="10,8" BorderBrush="#262638" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📥 Backlog / To Do" Foreground="#93C5FD" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="6,1" Margin="4,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="BacklogCountText" Text="0" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <Button Grid.Column="2" Content="+" ToolTip="Add Note to Backlog" Click="AddBacklog_Click"
                                        Background="Transparent" Foreground="#93C5FD" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Padding="4,0"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="BacklogColumnPanel" Margin="6" MinHeight="100" AllowDrop="True" Drop="Column_Drop" DragOver="Column_DragOver" Tag="backlog"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Column 2: In Progress -->
                <Border Grid.Column="1" Background="#14141D" BorderBrush="#262638" BorderThickness="1" CornerRadius="8" Margin="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#1B1B26" CornerRadius="8,8,0,0" Padding="10,8" BorderBrush="#262638" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⏳ In Progress" Foreground="#FCD34D" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#2E2415" CornerRadius="8" Padding="6,1" Margin="4,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="InProgressCountText" Text="0" Foreground="#F59E0B" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <Button Grid.Column="2" Content="+" ToolTip="Add Note In Progress" Click="AddInProgress_Click"
                                        Background="Transparent" Foreground="#FCD34D" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Padding="4,0"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="InProgressColumnPanel" Margin="6" MinHeight="100" AllowDrop="True" Drop="Column_Drop" DragOver="Column_DragOver" Tag="in-progress"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Column 3: Suspense & Review -->
                <Border Grid.Column="2" Background="#14141D" BorderBrush="#262638" BorderThickness="1" CornerRadius="8" Margin="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#1B1B26" CornerRadius="8,8,0,0" Padding="10,8" BorderBrush="#262638" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚠️ Suspense / Review" Foreground="#FCA5A5" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#311717" CornerRadius="8" Padding="6,1" Margin="4,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SuspenseCountText" Text="0" Foreground="#EF4444" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <Button Grid.Column="2" Content="+" ToolTip="Add Suspense Note" Click="AddSuspense_Click"
                                        Background="Transparent" Foreground="#FCA5A5" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Padding="4,0"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SuspenseColumnPanel" Margin="6" MinHeight="100" AllowDrop="True" Drop="Column_Drop" DragOver="Column_DragOver" Tag="suspense"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Column 4: Done -->
                <Border Grid.Column="3" Background="#14141D" BorderBrush="#262638" BorderThickness="1" CornerRadius="8" Margin="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#1B1B26" CornerRadius="8,8,0,0" Padding="10,8" BorderBrush="#262638" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="✅ Completed" Foreground="#86EFAC" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#142A1D" CornerRadius="8" Padding="6,1" Margin="4,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DoneCountText" Text="0" Foreground="#22C55E" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <Button Grid.Column="2" Content="+" ToolTip="Add Completed Note" Click="AddDone_Click"
                                        Background="Transparent" Foreground="#86EFAC" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" Padding="4,0"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DoneColumnPanel" Margin="6" MinHeight="100" AllowDrop="True" Drop="Column_Drop" DragOver="Column_DragOver" Tag="done"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Status -->
            <Border Grid.Row="3" Background="#101018" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="14,6">
                <Grid>
                    <TextBlock Text="💡 Drag cards or use ◀ / ▶ arrows to move items across stages. Double-click any card to open note."
                               Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
