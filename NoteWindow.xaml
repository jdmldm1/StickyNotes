<Window x:Class="StickyNotes__.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sticky Note" Height="320" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">
    
    <Window.Resources>
        <!-- Custom styled scrollbar for editor -->
        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb Background="LightGray" Opacity="0.5"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder" CornerRadius="8" BorderThickness="1">
        <DockPanel LastChildFill="True">
            <!-- Top CUI / Classification Banner -->
            <Border x:Name="CuiTopBanner" DockPanel.Dock="Top" Background="#5C2D91" Height="22" Visibility="Collapsed" Cursor="Hand" ToolTip="Classification Banner (Click to change or toggle)" MouseLeftButtonUp="CuiBanner_Click">
                <TextBlock x:Name="CuiTopBannerText" Text="CUI // FEDCON" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            </Border>

            <!-- Bottom CUI / Classification Banner -->
            <Border x:Name="CuiBottomBanner" DockPanel.Dock="Bottom" Background="#5C2D91" Height="22" Visibility="Collapsed" Cursor="Hand" ToolTip="Classification Banner (Click to change or toggle)" MouseLeftButtonUp="CuiBanner_Click">
                <TextBlock x:Name="CuiBottomBannerText" Text="CUI // FEDCON" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- Custom Header -->
                <Border Grid.Row="0" BorderBrush="#55FFFFFF" BorderThickness="0,0,0,2">
                <Grid x:Name="HeaderGrid" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/> <!-- Toggle Preview -->
                        <ColumnDefinition Width="Auto"/> <!-- Toggle AI Chat -->
                        <ColumnDefinition Width="Auto"/> <!-- Time Machine -->
                        <ColumnDefinition Width="Auto"/> <!-- Backlinks -->
                        <ColumnDefinition Width="Auto"/> <!-- In-Meeting HUD -->
                        <ColumnDefinition Width="Auto"/> <!-- Options -->
                        <ColumnDefinition Width="Auto"/> <!-- Close -->
                    </Grid.ColumnDefinitions>

                    <!-- New Note -->
                    <Button Grid.Column="0" Content="+" Click="NewButton_Click" ToolTip="New Note (Win+Alt+N)"
                            Width="30" Height="30" Margin="5,0,0,0" Background="Transparent" BorderThickness="0"
                            Foreground="#e0e0e0" FontSize="18" FontWeight="Bold" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

                    <!-- Title / Drag bar -->
                    <TextBlock Grid.Column="1" x:Name="TitleTextBlock" Text="Sticky Note"
                                Foreground="#e0e0e0" FontSize="11" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>

                    <!-- Toggle Preview -->
                    <Button Grid.Column="2" x:Name="PreviewToggleButton" Content="👁" Click="PreviewToggleButton_Click" ToolTip="Toggle Markdown Preview"
                            Width="30" Height="30" Background="Transparent" BorderThickness="0"
                            Foreground="#e0e0e0" FontSize="12.5" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

                    <!-- Toggle AI Chat -->
                    <Button Grid.Column="3" x:Name="AiChatToggleButton" Content="💬" Click="AiChatToggleButton_Click" ToolTip="AI Chat Assistant"
                            Width="30" Height="30" Background="Transparent" BorderThickness="0"
                            Foreground="#e0e0e0" FontSize="12" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Visibility="Collapsed"/>

                    <!-- Time Machine -->
                    <Button Grid.Column="4" x:Name="TimeMachineButton" Content="🕒" Click="TimeMachineButton_Click" ToolTip="Time Machine (Version History)"
                            Width="30" Height="30" Background="Transparent" BorderThickness="0"
                            Foreground="#e0e0e0" FontSize="12" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

                    <!-- Backlinks -->
                    <Button Grid.Column="5" x:Name="BacklinksToggleButton" Content="🔗" Click="BacklinksToggleButton_Click" ToolTip="Linked Notes"
                            Width="30" Height="30" Background="Transparent" BorderThickness="0"
                            Foreground="#e0e0e0" FontSize="11" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Visibility="Collapsed"/>

                    <!-- In-Meeting HUD -->
                    <Button Grid.Column="6" x:Name="MeetingHudButton" Content="🛰️" Click="MeetingHudButton_Click" ToolTip="In-Meeting HUD &amp; BLUF Formatter"
                            Width="28" Height="30" Background="Transparent" BorderThickness="0"
                            Foreground="#e0e0e0" FontSize="11" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

                    <!-- Options -->
                    <Button Grid.Column="7" Content="..." Click="OptionsButton_Click" ToolTip="Options"
                            Width="30" Height="30" Background="Transparent" BorderThickness="0"
                            Foreground="#e0e0e0" FontSize="14" FontWeight="Bold" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>

                    <!-- Close -->
                    <Button Grid.Column="8" Content="✕" Click="CloseButton_Click" ToolTip="Close"
                            Width="30" Height="30" Margin="0,0,5,0" Background="Transparent" BorderThickness="0"
                            Foreground="#e0e0e0" FontSize="12" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                </Grid>
                </Border>

            <!-- Formatting Toolbar (Row 1) -->
            <Border Grid.Row="1" Background="#1a1a1a" BorderBrush="#2a2a2a" BorderThickness="0,0,0,1" Padding="5,3">
                <WrapPanel Orientation="Horizontal">
                    <!-- Text Style Group -->
                    <Button Width="26" Height="24" Click="FormatBold_Click" ToolTip="Bold (Ctrl+B)" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="12" FontFamily="Segoe UI"/>
                    </Button>
                    <Button Width="26" Height="24" Click="FormatItalic_Click" ToolTip="Italic (Ctrl+I)" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="I" FontStyle="Italic" FontSize="12" FontFamily="Segoe UI"/>
                    </Button>
                    <Button Width="26" Height="24" Click="FormatUnderline_Click" ToolTip="Underline (Ctrl+U)" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="U" TextDecorations="Underline" FontSize="12" FontFamily="Segoe UI"/>
                    </Button>
                    <Button Width="26" Height="24" Click="FormatStrikethrough_Click" ToolTip="Strikethrough" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="12" FontFamily="Segoe UI"/>
                    </Button>
                    <Button Width="26" Height="24" Click="FormatHighlight_Click" ToolTip="Highlight" Background="Transparent" BorderThickness="0" Foreground="#FFD700" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="&#x2590;" FontSize="13"/>
                    </Button>
                    <Button Width="26" Height="24" Click="FormatTextColor_Click" ToolTip="Text Color" Background="Transparent" BorderThickness="0" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="A" FontWeight="Bold" FontSize="12" FontFamily="Segoe UI" Foreground="#ff6b6b"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="16" Background="#333333" Margin="3,0" VerticalAlignment="Center"/>

                    <!-- Font Size Group -->
                    <Button Width="24" Height="24" Click="FormatDecreaseFontSize_Click" ToolTip="Decrease Font Size" Background="Transparent" BorderThickness="0" Foreground="#aaaaaa" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="A-" FontSize="10" FontFamily="Segoe UI"/>
                    </Button>
                    <Button Width="24" Height="24" Click="FormatIncreaseFontSize_Click" ToolTip="Increase Font Size" Background="Transparent" BorderThickness="0" Foreground="#aaaaaa" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="A+" FontSize="10" FontFamily="Segoe UI"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="16" Background="#333333" Margin="3,0" VerticalAlignment="Center"/>

                    <!-- Block Style Group -->
                    <Button Width="26" Height="24" Click="FormatHeading1_Click" ToolTip="Heading 1" Background="Transparent" BorderThickness="0" Foreground="#aaaaaa" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="H1" FontWeight="Bold" FontSize="10" FontFamily="Segoe UI"/>
                    </Button>
                    <Button Width="26" Height="24" Click="FormatHeading2_Click" ToolTip="Heading 2" Background="Transparent" BorderThickness="0" Foreground="#aaaaaa" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="H2" FontWeight="Bold" FontSize="10" FontFamily="Segoe UI"/>
                    </Button>
                    <Button Width="28" Height="24" Click="FormatBlockquote_Click" ToolTip="Quote Block" Background="Transparent" BorderThickness="0" Foreground="#aaaaaa" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="&#x201C;" FontSize="18" FontWeight="Bold" FontFamily="Georgia"/>
                    </Button>
                    <Button Width="34" Height="24" Click="FormatCodeBlock_Click" ToolTip="Code Block" Background="Transparent" BorderThickness="0" Foreground="#a8ff78" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="10"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="16" Background="#333333" Margin="3,0" VerticalAlignment="Center"/>

                    <!-- List Group -->
                    <Button Width="28" Height="24" Click="FormatBulletList_Click" ToolTip="Bullet List" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="&#x2261;" FontSize="15" Margin="0,-1,0,0"/>
                    </Button>
                    <Button Width="28" Height="24" Click="FormatNumberedList_Click" ToolTip="Numbered List" Background="Transparent" BorderThickness="0" Foreground="White" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="1." FontSize="11" FontFamily="Segoe UI" FontWeight="Bold"/>
                    </Button>
                    <Button Width="24" Height="24" Click="FormatOutdent_Click" ToolTip="Decrease Indent" Background="Transparent" BorderThickness="0" Foreground="#aaaaaa" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="&#x21E4;" FontSize="12"/>
                    </Button>
                    <Button Width="24" Height="24" Click="FormatIndent_Click" ToolTip="Increase Indent" Background="Transparent" BorderThickness="0" Foreground="#aaaaaa" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="&#x21E5;" FontSize="12"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="16" Background="#333333" Margin="3,0" VerticalAlignment="Center"/>

                    <!-- Insert Group -->
                    <Button Width="28" Height="24" Click="InsertCheckbox_Click" ToolTip="Insert Checkbox / Task item" Background="Transparent" BorderThickness="0" Foreground="#88ff88" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="&#x2611;" FontSize="13"/>
                    </Button>
                    <Button Width="28" Height="24" Click="InsertHyperlink_Click" ToolTip="Insert Hyperlink" Background="Transparent" BorderThickness="0" Foreground="#4db8ff" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="&#x1F517;" FontSize="11"/>
                    </Button>
                    <Button Width="28" Height="24" Click="InsertDivider_Click" ToolTip="Insert Divider" Background="Transparent" BorderThickness="0" Foreground="#aaaaaa" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="&#x2015;" FontSize="14"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="16" Background="#333333" Margin="3,0" VerticalAlignment="Center"/>

                    <!-- Clear Formatting -->
                    <Button Width="28" Height="24" Click="FormatClear_Click" ToolTip="Clear Formatting" Background="Transparent" BorderThickness="0" Foreground="#aaaaaa" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="&#x2715;A" FontSize="10" FontFamily="Segoe UI"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="16" Background="#333333" Margin="3,0" VerticalAlignment="Center"/>

                    <!-- Audio Dictation & Voice Memos -->
                    <Button x:Name="AudioToolbarToggleBtn" Width="28" Height="24" Click="ToggleAudioBar_Click" ToolTip="Voice Dictation &amp; Audio Memos (100% Offline)" Background="Transparent" BorderThickness="0" Foreground="#ffaa44" Cursor="Hand" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <TextBlock Text="🎙️" FontSize="11"/>
                    </Button>
                </WrapPanel>
            </Border>

            <!-- Note Workspace & AI Chat Grid (Grid.Row="2") -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: AudioBar -->
                    <RowDefinition Height="*"/>    <!-- Row 1: Note Editor & Overlays -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: AI Chat / Backlinks -->
                </Grid.RowDefinitions>

                <!-- Offline Audio Dictation & Voice Memo Bar (Row 0 - Collapsed by default) -->
                <Border x:Name="AudioBar" Grid.Row="0" Visibility="Collapsed" Background="#221811" BorderBrush="#e67e22" BorderThickness="0,0,0,1" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Live Dictation Toggle -->
                        <Button Grid.Column="0" x:Name="DictateToggleBtn" Click="DictateToggle_Click" Content="🎤 Live Dictate"
                                Padding="8,2" Margin="0,0,6,0" Background="#3a2512" Foreground="#ffaa44" BorderBrush="#e67e22" BorderThickness="1" FontSize="10" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>

                        <!-- Voice Memo Record -->
                        <Button Grid.Column="1" x:Name="VoiceMemoRecordBtn" Click="VoiceMemoRecord_Click" Content="⏺ Record Memo (.wav)"
                                Padding="8,2" Margin="0,0,6,0" Background="#3d1414" Foreground="#ff6b6b" BorderBrush="#ff4444" BorderThickness="1" FontSize="10" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>

                        <!-- Status text -->
                        <TextBlock Grid.Column="2" x:Name="AudioStatusText" Text="100% Offline Speech Engine Ready" Foreground="#bbbbbb" FontSize="9.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                        <!-- Close button -->
                        <Button Grid.Column="3" Content="✕" Click="CloseAudioBar_Click" Background="Transparent" BorderThickness="0" Foreground="#888888" FontSize="11" Cursor="Hand" ToolTip="Hide Voice Bar"/>
                    </Grid>
                </Border>

                <!-- Note Editor Area (Row 1) -->
                <ScrollViewer x:Name="EditorScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AllowDrop="True" DragEnter="Editor_DragEnter" DragLeave="Editor_DragLeave" DragOver="Editor_DragOver" Drop="Editor_Drop">
                    <StackPanel>
                        <!-- Image -->
                        <Border x:Name="ImageBorder" MaxHeight="140" Margin="10,5,10,0" CornerRadius="4" ClipToBounds="True" Visibility="Collapsed"
                                Cursor="Hand" ToolTip="Click to view full size &#183; Right-click for more options"
                                MouseLeftButtonUp="NoteImage_Click" MouseRightButtonUp="NoteImage_RightClick">
                            <Image x:Name="NoteImage" Stretch="Uniform"/>
                        </Border>

                        <!-- File Attachments -->
                        <WrapPanel x:Name="AttachmentsPanel" Margin="10,5,10,0" Orientation="Horizontal"/>

                        <!-- Drag & Drop Hint Overlay -->
                        <Border x:Name="DropHintBorder" Margin="10,5,10,0" Padding="10,8" CornerRadius="6"
                                Background="#1a0084ff" BorderBrush="#0084ff" BorderThickness="1"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock Text="📎 Drop files here to attach" Foreground="#0084ff" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Note Title TextBox -->
                        <TextBox x:Name="NoteTitleTextBox" Margin="10,8,10,2" Background="Transparent"
                                 BorderThickness="0" Foreground="#ffffff" CaretBrush="White"
                                 FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="15" FontWeight="Bold"
                                 TextWrapping="Wrap" AcceptsReturn="False" TextChanged="NoteTitleTextBox_TextChanged"
                                 BorderBrush="Transparent"/>

                        <!-- Divider line -->
                        <Border x:Name="TitleDivider" Height="1" Background="#33ffffff" Margin="10,4,10,4"/>

                        <!-- Text Editor -->
                        <RichTextBox x:Name="NoteRichTextBox" Margin="10,4,10,10" MinHeight="100" Background="Transparent"
                                     BorderThickness="0" Foreground="#ffffff" CaretBrush="White"
                                     FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="14"
                                     TextChanged="NoteRichTextBox_TextChanged"
                                     SelectionChanged="NoteRichTextBox_SelectionChanged"
                                     PreviewKeyDown="NoteRichTextBox_PreviewKeyDown"
                                     PreviewMouseLeftButtonDown="NoteRichTextBox_PreviewMouseLeftButtonDown"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <RichTextBox.Resources>
                                <Style TargetType="{x:Type Paragraph}">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Markdown Preview Area (Row 1 - overlays Editor) -->
                <FlowDocumentScrollViewer x:Name="MarkdownPreviewViewer" Grid.Row="1" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Background="Transparent"/>

                <!-- Locked Secure Note Overlay (Row 1 - fully opaque, hides the editor/ciphertext underneath) -->
                <Border x:Name="LockedOverlay" Grid.Row="1" Background="#F2141414" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220">
                        <TextBlock Text="🔒" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="This note is secure" Foreground="#e0e0e0" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="Enter your vault password to view it." Foreground="#88ffffff" FontSize="11"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
                        <Button Content="Unlock" Click="UnlockNoteButton_Click" Width="100" Height="30"
                                Background="#0084ff" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Word count / reading time footer (overlays bottom-right of the editor) -->
                <TextBlock x:Name="WordCountText" Grid.Row="1" Text="0 words" Foreground="#66ffffff" FontSize="9.5"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,6" IsHitTestVisible="False"/>

                <!-- AI Chat Panel (Row 2 - Collapsed by default) -->
                <Border x:Name="AiChatPanel" Grid.Row="2" Height="160" Background="#161616" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Chat History -->
                        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel x:Name="ChatHistoryPanel"/>
                        </ScrollViewer>

                        <!-- Input Bar -->
                        <Grid Grid.Row="1" Margin="8,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AiPromptTextBox" Grid.Column="0" Background="#262626" Foreground="#ffffff" BorderBrush="#333333" BorderThickness="1" Padding="8,4" FontSize="12" CaretBrush="White" KeyDown="AiPromptTextBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Send" Click="SendAiPrompt_Click" Padding="12,4" Margin="5,0,0,0" Background="#0084ff" Foreground="#ffffff" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Time Machine Panel (Full Workspace Overlay) -->
                <Border x:Name="TimeMachinePanel" Grid.Row="1" Grid.RowSpan="2" Background="#18181b" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#202024" BorderBrush="#2e2e34" BorderThickness="0,0,0,1" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🕒" FontSize="12" Margin="2,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Time Machine" Foreground="#ffffff" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Background="#2a2a30" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TimeMachineVersionCountText" Text="0 versions" Foreground="#a1a1aa" FontSize="9.5"/>
                                    </Border>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="TimeMachineViewToggleBtn" Content="Full Text" Click="TimeMachineViewToggle_Click" ToolTip="Toggle between line diff and full historical text"
                                            Padding="6,2" Margin="0,0,4,0" Background="#27272a" Foreground="#d4d4d8" BorderBrush="#3f3f46" BorderThickness="1" FontSize="9.5" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="TimeMachineCopyBtn" Content="📋 Copy" Click="TimeMachineCopy_Click" ToolTip="Copy historical text to clipboard"
                                            Padding="6,2" Margin="0,0,4,0" Background="#27272a" Foreground="#d4d4d8" BorderBrush="#3f3f46" BorderThickness="1" FontSize="9.5" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                                    </Button>
                                    <Button x:Name="TimeMachineRestoreBtn" Content="⏪ Restore" Click="TimeMachineRestore_Click" ToolTip="Restore this version (current note will be backed up)"
                                            Padding="8,2" Margin="0,0,6,0" Background="#0084ff" Foreground="#ffffff" FontWeight="SemiBold" BorderThickness="0" FontSize="9.5" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="✕" Click="CloseTimeMachine_Click" Background="Transparent" BorderThickness="0" Foreground="#a0a0a0" FontSize="11" Cursor="Hand" ToolTip="Close Time Machine"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Split: Revisions List & Diff View -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" MinWidth="90" MaxWidth="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Revisions Timeline (Column 0) -->
                            <Border Grid.Column="0" Background="#141416" BorderBrush="#27272a" BorderThickness="0,0,1,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="HistoryVersionsPanel" Margin="4,4,4,4"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Diff & Content Viewer (Column 1) -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Details Strip -->
                                <Border Grid.Row="0" Background="#1b1b1f" BorderBrush="#27272a" BorderThickness="0,0,0,1" Padding="6,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="DiffRevisionTimeText" Text="Selected Version" Foreground="#e4e4e7" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="DiffWordDeltaText" Text="" Foreground="#7ee787" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="DiffStatsText" Text="" Foreground="#a1a1aa" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Diff Viewer -->
                                <ScrollViewer x:Name="DiffScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#111113" Padding="2">
                                    <StackPanel x:Name="DiffLinesPanel"/>
                                </ScrollViewer>

                                <!-- Full Text Viewer -->
                                <ScrollViewer x:Name="FullContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#111113" Visibility="Collapsed" Padding="6">
                                    <TextBox x:Name="FullContentTextBox" IsReadOnly="True" Background="Transparent" Foreground="#d4d4d8" BorderThickness="0" TextWrapping="Wrap" FontFamily="Consolas, Segoe UI Variable Text" FontSize="11" CaretBrush="White"/>
                                </ScrollViewer>

                                <!-- Empty State -->
                                <StackPanel x:Name="TimeMachineEmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="14">
                                    <TextBlock Text="⏳" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="No history yet" Foreground="#ffffff" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Edits will be saved automatically as you type." Foreground="#71717a" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Footer -->
                        <Border Grid.Row="2" Background="#141416" BorderBrush="#27272a" BorderThickness="0,1,0,0" Padding="6,2">
                            <TextBlock Text="🟢 Added in current  🔴 Removed from revision  · Current note backed up on restore" Foreground="#666670" FontSize="8.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Backlinks Panel (Connected Notes) -->
                <Border x:Name="BacklinksPanel" Grid.Row="2" Height="120" Background="#161616" BorderBrush="#2d2d2d" BorderThickness="0,1,0,0" Visibility="Collapsed">
                    <Grid Margin="10,8,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="🔗  Linked Notes" Foreground="#aaaaaa" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="✕" Click="CloseBacklinks_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#aaaaaa" FontSize="10" Cursor="Hand"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                            <WrapPanel x:Name="BacklinksNotePanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" x:Name="CategoryComboBox" SelectionChanged="CategoryComboBox_SelectionChanged"
                          ToolTip="Change Category"
                          Margin="10,0,6,0" Padding="5,1" FontSize="9.5" MinWidth="66" MaxWidth="110"
                          Background="#20ffffff" Foreground="#ffffff" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" x:Name="TagsTextBlock" Text="No tags"
                           Foreground="#A0ffffff" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Right-click to manage tags" PreviewMouseRightButtonDown="TagsTextBlock_PreviewMouseRightButtonDown"/>

                <Button Grid.Column="2" x:Name="AiFormatButton" Content="🔷" Click="AiFormatButton_Click" ToolTip="AI Quick Format"
                        Padding="6,1" Background="#20ffffff" Foreground="#ffffff" FontSize="10" BorderThickness="0" Cursor="Hand" Margin="0,0,5,0" Visibility="Collapsed"/>

                <Button Grid.Column="3" x:Name="AiSummaryButton" Content="⚡" Click="AiSummaryButton_Click" ToolTip="One-Click AI Summary / TL;DR"
                        Padding="6,1" Background="#20ffffff" Foreground="#ffffff" FontSize="10" BorderThickness="0" Cursor="Hand" Margin="0,0,5,0" Visibility="Collapsed"/>

                <Button Grid.Column="4" x:Name="AiTagButton" Content="🏷️" Click="AiTagButton_Click" ToolTip="Generate Tags using Local AI"
                        Padding="6,1" Background="#20ffffff" Foreground="#ffffff" FontSize="10" BorderThickness="0" Cursor="Hand" Margin="0,0,5,0" Visibility="Collapsed"/>

                <Button Grid.Column="5" Content="+ Tag" Click="AddTagButton_Click"
                        Padding="5,1" Background="#20ffffff" Foreground="#ffffff" FontSize="9" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <!-- Wikilink Autocomplete Popup -->
            <Popup x:Name="WikilinkPopup" AllowsTransparency="True" StaysOpen="False" PlacementTarget="{Binding ElementName=NoteRichTextBox}" Placement="Relative">
                <Border Background="#1f1f23" BorderBrush="#0084ff" BorderThickness="1.5" CornerRadius="6" Width="260" MaxHeight="200">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="Black" Opacity="0.6"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#27272a" CornerRadius="5,5,0,0" Padding="8,4">
                            <TextBlock Text="🔗 Link to Note  (Enter to select, Esc to dismiss)" Foreground="#a1a1aa" FontSize="9.5" FontWeight="SemiBold"/>
                        </Border>
                        <ListBox x:Name="WikilinkListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" MaxHeight="160"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MouseDoubleClick="WikilinkListBox_MouseDoubleClick"
                                 KeyDown="WikilinkListBox_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📝" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#f4f4f5" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="#71717a" FontSize="9.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Popup>

            <Popup x:Name="FormatToolbarPopup" AllowsTransparency="True" Placement="RelativePoint" StaysOpen="True" VerticalOffset="-35" HorizontalOffset="0">
                <Border Background="#CC1A1A1A" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="6" Padding="3">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="Black" Opacity="0.45"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Width" Value="24"/>
                                <Setter Property="Height" Value="24"/>
                                <Setter Property="Margin" Value="1,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Resources>
                        <Button Click="FormatBold_Click" ToolTip="Bold">
                            <TextBlock Text="B" FontWeight="Bold" Foreground="White" FontSize="11"/>
                        </Button>
                        <Button Click="FormatItalic_Click" ToolTip="Italic">
                            <TextBlock Text="I" FontStyle="Italic" Foreground="White" FontSize="11" FontFamily="Georgia"/>
                        </Button>
                        <Button Click="FormatUnderline_Click" ToolTip="Underline">
                            <TextBlock Text="U" TextDecorations="Underline" Foreground="White" FontSize="11"/>
                        </Button>
                        <Button Click="FormatStrikethrough_Click" ToolTip="Strikethrough">
                            <TextBlock Text="S" TextDecorations="Strikethrough" Foreground="White" FontSize="11"/>
                        </Button>
                        <Button Click="FormatHighlight_Click" ToolTip="Highlight Text">
                            <TextBlock Text="🖌" Foreground="White" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
        </DockPanel>
    </Border>
</Window>
