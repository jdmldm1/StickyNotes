<Window x:Class="StickyNotes__.ClipboardPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Note from Clipboard" Height="520" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Border Background="#F2141414" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📋  Add Note from Clipboard" Foreground="#ffffff" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Grid.Column="1" Content="✕" Click="CloseButton_Click" ToolTip="Close"
                        Width="30" Height="26" Margin="0,0,6,0" Background="Transparent" BorderThickness="0"
                        Foreground="#ffffff" FontSize="11" Cursor="Hand"/>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="14,4,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="EmptyStateText" Grid.Row="1" Text="Nothing copied yet -- copy some text or an image and it'll show up here."
                           Foreground="#66ffffff" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="20,0,20,0" Visibility="Collapsed"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ClipboardItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" CornerRadius="8" BorderThickness="1" BorderBrush="#333333" Background="#161616" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Snippet}" Foreground="#ffffff" FontSize="12.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{Binding TextVisibility}"/>
                                            <Image Source="{Binding ImageSource}" MaxHeight="80" Stretch="Uniform" HorizontalAlignment="Left" Visibility="{Binding ImageVisibility}"/>
                                            <TextBlock Text="{Binding TimeDisplay}" Foreground="#555555" FontSize="10" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Click="AddNoteButton_Click" Tag="{Binding Id}"
                                                Width="32" Height="32" Background="#0084ff" Foreground="#ffffff" FontSize="14" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Add as Note">
                                            <TextBlock Text="+" Margin="0,-2,0,0"/>
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="16"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
