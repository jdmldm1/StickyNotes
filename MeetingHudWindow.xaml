<Window x:Class="StickyNotes__.MeetingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="In-Meeting HUD" Height="380" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Border x:Name="MainHudBorder" Background="#EE161822" BorderBrush="#0084FF" BorderThickness="1.5" CornerRadius="10" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title & Controls -->
                <RowDefinition Height="Auto"/> <!-- Stopwatch & Roll Call Strip -->
                <RowDefinition Height="*"/>    <!-- Captured Items -->
                <RowDefinition Height="Auto"/> <!-- Quick Capture Input -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="#20FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0" Padding="12,8" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛰️ " FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HudTitleText" Text="Meeting HUD" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinButton" Content="📌" ToolTip="Toggle Always on Top" Click="PinButton_Click"
                                Background="Transparent" Foreground="#8888AA" BorderThickness="0" FontSize="11" Padding="4,1" Cursor="Hand" Margin="0,0,4,0"/>
                        <Button Content="✕" ToolTip="Close HUD" Click="CloseButton_Click"
                                Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" FontSize="11" Padding="6,1" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stopwatch & Roll-Call Strip -->
            <Border Grid.Row="1" Background="#0CFFFFFF" Padding="12,6" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stopwatch Timer -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="TimerDisplay" Text="00:00:00" Foreground="#38BDF8" FontFamily="Consolas" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="TimerPlayPauseBtn" Content="▶" ToolTip="Start/Pause Timer" Click="TimerPlayPause_Click"
                                Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Padding="6,2" FontSize="9.5" Cursor="Hand" Margin="0,0,3,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                        </Button>
                        <Button Content="⏹" ToolTip="Reset Timer" Click="TimerReset_Click"
                                Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" Padding="6,2" FontSize="9.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Attendees Roll-Call Wrap -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="AttendeesRollCallPanel" VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Captured Action Items & Key Points List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#08FFFFFF" Margin="4">
                <StackPanel x:Name="ItemsPanel" Margin="8,4">
                    <TextBlock x:Name="EmptyNoticeText" Text="⚡ Fast-capture meeting notes, decisions, or suspenses below..." Foreground="#64748B" FontSize="11" FontStyle="Italic" Margin="4,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Quick Capture Input -->
            <Border Grid.Row="3" Background="#14141E" BorderBrush="#262638" BorderThickness="0,1,0,1" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QuickInputBox" Grid.Column="0" Background="#1C1C28" Foreground="#FFFFFF"
                             BorderBrush="#38384E" BorderThickness="1" Padding="8,5" FontSize="11"
                             CaretBrush="White" KeyDown="QuickInputBox_KeyDown"
                             ToolTip="Type note or action item and press Enter to timestamp"/>
                    <Button Grid.Column="1" Content="➕ Add" Click="QuickAdd_Click"
                            Background="#0084FF" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5"
                            BorderThickness="0" Padding="10,4" Margin="6,0,0,0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Footer Actions -->
            <Border Grid.Row="4" Background="#101018" CornerRadius="0,0,8,8" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📋 Copy BLUF Brief" ToolTip="Copy executive/military summary to clipboard" Click="CopyBluf_Click"
                                Background="#1E293B" Foreground="#7DD3FC" BorderBrush="#0284C7" BorderThickness="1"
                                Padding="8,3" FontSize="10" Cursor="Hand" Margin="0,0,6,0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="CuiBadgeBtn" Content="🛡️ CUI Mode" ToolTip="Toggle CUI Security Marking" Click="ToggleCui_Click"
                                Background="#2E1065" Foreground="#D8B4FE" BorderBrush="#7C3AED" BorderThickness="1"
                                Padding="8,3" FontSize="10" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="1" Content="📝 Open Full Note" Click="OpenFullNote_Click"
                            Background="#262636" Foreground="#E2E8F0" BorderBrush="#475569" BorderThickness="1"
                            Padding="8,3" FontSize="10" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
