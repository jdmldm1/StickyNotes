<Window x:Class="StickyNotes__.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Viewer" Height="650" Width="850" MinHeight="300" MinWidth="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        SizeChanged="Window_SizeChanged">

    <Border Background="#F2141414" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🖼️  Image Viewer" Foreground="#ffffff" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>

                <TextBlock Grid.Column="1" x:Name="CopiedText" Text="✅ Copied"
                           Foreground="#4dd67a" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="0,0,10,0" Visibility="Collapsed"/>

                <TextBlock Grid.Column="2" x:Name="ZoomText" Text="100%" Foreground="#aaaaaa" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="36" TextAlignment="Right"/>

                <Button Grid.Column="3" Content="−" Click="ZoomOutButton_Click" ToolTip="Zoom Out"
                        Width="26" Height="26" Background="Transparent" BorderThickness="0"
                        Foreground="#e0e0e0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>

                <Button Grid.Column="4" Content="⊡" Click="ZoomResetButton_Click" ToolTip="Fit to Window"
                        Width="26" Height="26" Background="Transparent" BorderThickness="0"
                        Foreground="#e0e0e0" FontSize="12" Cursor="Hand"/>

                <Button Grid.Column="5" Content="+" Click="ZoomInButton_Click" ToolTip="Zoom In"
                        Width="26" Height="26" Background="Transparent" BorderThickness="0"
                        Foreground="#e0e0e0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>

                <Border Grid.Column="6" Width="1" Height="16" Background="#333333" Margin="8,0" VerticalAlignment="Center"/>

                <Button Grid.Column="7" Content="Copy Image" Click="CopyButton_Click" ToolTip="Copy Image to Clipboard"
                        Height="26" Padding="8,0" Margin="0,0,6,0" Background="#1a0084ff" BorderThickness="0"
                        Foreground="#0084ff" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>

                <Button Grid.Column="8" Content="✕" Click="CloseButton_Click" ToolTip="Close (Esc)"
                        Width="30" Height="26" Margin="0,0,6,0" Background="Transparent" BorderThickness="0"
                        Foreground="#ffffff" FontSize="11" Cursor="Hand"/>
            </Grid>

            <!-- Image Area -->
            <ScrollViewer x:Name="ImageScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="ImageScrollViewer_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="ImageScrollViewer_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="ImageScrollViewer_PreviewMouseLeftButtonUp">
                <Grid x:Name="ImageHost" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="ViewerImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
